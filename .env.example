DEV_ENV=development
REDIS_URL=redis://localhost:6379
# Optional when running inside Docker and REDIS_URL points to localhost on the host.
REDIS_HOST=redis
REDIS_PORT=6379
UPLOAD_FOLDER=/uploads
FILE_URL_PATH=http://localhost:3020/uploads
MAX_FILE_SIZE=5
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.webp
IMAGE_WEBP_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
SERVICE_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha
DB_NAME=sest

OTL_METRICS_EXPORTER_URL=http://localhost:4318/v1/metrics
OTL_TRACE_EXPORTER_URL=http://localhost:4318/v1/traces
